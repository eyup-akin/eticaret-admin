# Backend'in TAM adresi (şema + host + port).
#
# Bilgisayardan geliştirirken http://localhost:5289 yeterli.
# Telefondan/başka cihazdan test edecekseniz makinenin ağ IP'sini yazın:
#   VITE_API_TABAN=http://192.168.1.42:5289
#
# ⚠️ Bu dosya yalnızca `npm run dev` içindir. Üretim derlemesi
# .env.production'ı okur ve orası bilerek BOŞ — panel API ile aynı
# adresten sunulduğu için adresler göreli oluyor.
VITE_API_TABAN=http://localhost:5289
